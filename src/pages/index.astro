---
import SiteLayout from "../layouts/SiteLayout.astro";
const metadata = {
  "title": "Feng Xiang | Software Engineer at Waymo",
  "description": "Feng Xiang is a Software Engineer at Waymo with a background in machine learning, prediction, and robotics.",
  "canonical": "https://jasonxiang1.github.io/",
  "assetPrefix": "",
  "structuredData": {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Feng Xiang",
    "url": "https://jasonxiang1.github.io/",
    "image": "https://jasonxiang1.github.io/assets/headshot_img.JPG",
    "jobTitle": "Software Engineer",
    "worksFor": {
      "@type": "Organization",
      "name": "Waymo"
    },
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Carnegie Mellon University"
      },
      {
        "@type": "CollegeOrUniversity",
        "name": "George Washington University"
      }
    ],
    "sameAs": [
      "https://www.linkedin.com/in/fengxiang1/",
      "https://github.com/jasonxiang1"
    ],
    "knowsAbout": [
      "Reinforcement Learning",
      "Imitation Learning",
      "Motion Forecasting",
      "Computer Vision",
      "Robotics"
    ]
  }
};
---
<SiteLayout {...metadata}>
<main id="main">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Software Engineer · Waymo</p>
        <h1 id="hero-title">Building systems<br>for <em>intelligent agents.</em></h1>
        <p class="hero-description">I’m Feng, a Software Engineer at Waymo. My background spans machine learning, prediction, and robotics.</p>
        <div class="actions"><a class="button" href="#projects">Explore my projects</a><a class="button secondary" href="assets/pdf/resume.pdf">View resume <span class="sr-only">(PDF)</span></a></div>
        <p class="hero-note">From research questions to working systems.</p>
      </div>
      <figure class="portrait"><img src="assets/headshot_img.JPG" alt="Feng Xiang" width="480" height="600" fetchpriority="high"><figcaption><strong>Feng Xiang</strong><span>Learning · Reasoning · Robotics</span></figcaption></figure>
    </section>
    <section class="section wrap about-grid" id="about" aria-labelledby="about-title">
      <div><p class="eyebrow">About</p><h2 id="about-title">Curiosity, backed<br>by engineering.</h2></div>
      <div class="prose"><p class="lead">I build the foundational systems that enable intelligent agents to learn, reason, and operate effectively in complex environments.</p><p>I’m now a Software Engineer at Waymo. Previously, as a research engineer at ISEE AI, I worked across the full R&amp;D lifecycle: exploring learning paradigms, building training infrastructure, and using rigorous, data-driven analysis to understand and advance model capabilities.</p><p>I’m drawn to ambitious research problems and the engineering needed to turn an idea into a system that works.</p>
      <div class="education"><h3>Education</h3><p><strong>Carnegie Mellon University</strong><br>MS, Robotic Systems Development · 2022</p><p><strong>George Washington University</strong><br>BS, Mechanical Engineering · Minor in Electrical Engineering · 2018</p></div></div>
    </section>
    <section class="work-band" id="work" aria-labelledby="work-title"><div class="wrap section">
      <div class="section-heading"><div><p class="eyebrow">Selected experience</p><h2 id="work-title">Learning meets the real world.</h2></div><a class="text-link" href="assets/pdf/resume.pdf">Full resume (PDF)</a></div>
      <div class="experience"><div><h3>Waymo</h3><p>Software Engineer</p><p class="muted">Current role</p></div><div><p>Currently a Software Engineer at Waymo, following research and engineering work in learning systems and robotics.</p></div></div>
      <div class="experience"><div><h3>ISEE AI</h3><p>AI/ML Research Engineer</p><p class="muted">Previous role · Started June 2022</p></div><div><p class="lead">Prediction and sequential decision-making for autonomous systems.</p><p>End-to-end development of driving models for tractor-trailer navigation in unstructured logistics yards, alongside reinforcement and imitation learning, multi-agent simulation, and targeted model fine-tuning.</p><ul class="experience-points"><li>Built PyTorch simulation infrastructure generating over 200K training samples per second across 15K parallel multi-agent environments.</li><li>Developed data augmentation and fine-tuning pipelines to improve robustness in rare and long-tail scenarios.</li></ul></div></div>
      <div class="experience"><div><h3>Forterra</h3><p>Software Engineer</p><p class="muted">May – August 2021</p></div><div><p>Explored event-camera motion segmentation for sensor feasibility studies and implemented Gaussian Mixture Model multi-object tracking in C++ using simulated LiDAR data.</p></div></div>
    </div></section>
    <section class="section wrap" id="projects" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">Selected projects</p><h2 id="projects-title">Perception. Reasoning. Action.</h2></div><p>Research and engineering<br>across intelligent systems.</p></div>
      <div class="project-list">
        <article class="project-card" id="coborg">
          <div class="project-metric"><strong>84.62%</strong><span>task success in panel installation tests</span></div>
          <div class="project-copy"><p class="eyebrow">Robotics · Motion planning</p><h3><a href="pages/coborg.html">COBORG: a wearable third arm.</a></h3><p>Motion planning and stabilization for COBORG, a wearable robotic arm that assists technicians with overhead panel installation.</p><p class="project-tools">C++ / ROS / MoveIt / Octomap</p><div class="project-links"><a href="pages/coborg.html">Explore project</a><a href="https://mrsdprojects.ri.cmu.edu/2021teamc/">Project website</a><button class="quick-view" data-project="coborg" hidden>Quick view<span class="sr-only">: Backpack-Mounted Third Robot Arm</span></button></div></div>
        </article>
        <article class="project-card" id="gqa">
          <div class="project-metric"><strong>11%</strong><span>GraphVQA accuracy improvement on scene graph-deficient test sets</span></div>
          <div class="project-copy"><p class="eyebrow">Multimodal learning · Visual reasoning</p><h3><a href="pages/gqa.html">Scene graphs for visual question answering.</a></h3><p>Generating structured relationships between objects to improve visual question answering when scene graph annotations are missing.</p><p class="project-tools">MotifNet / GraphVQA / Scene graphs</p><div class="project-links"><a href="pages/gqa.html">Explore project</a><a href="assets/pdf/gqa.pdf">Project paper (PDF)</a><button class="quick-view" data-project="gqa" hidden>Quick view<span class="sr-only">: Scene Graphs for Visual Question Answering</span></button></div></div>
        </article>
        <article class="project-card" id="centerpoint">
          <div class="project-metric"><strong>83%</strong><span>average precision for vehicle and pedestrian object–attribute pairs</span></div>
          <div class="project-copy"><p class="eyebrow">Computer vision · 3D perception</p><h3><a href="pages/centerpoint.html">Joint object–attribute prediction.</a></h3><p>Extending a LiDAR-based 3D detector to jointly predict objects and attributes, including vehicle type and pedestrian posture.</p><p class="project-tools">CenterPoint / nuScenes / LiDAR</p><div class="project-links"><a href="pages/centerpoint.html">Explore project</a><a href="https://vlrproject.wordpress.com/">Project website</a><button class="quick-view" data-project="centerpoint" hidden>Quick view<span class="sr-only">: CenterPoint Joint Object–Attribute Prediction</span></button></div></div>
        </article>
      </div>
    </section>
    <section class="section wrap skills-section" aria-labelledby="skills-title"><p class="eyebrow">Toolkit</p><h2 id="skills-title">Tools for the full research cycle.</h2>
      <div class="tab-buttons" role="tablist" aria-label="Skills categories" hidden>
        <button id="domains-tab" role="tab" aria-controls="domains" aria-selected="true">Technical domains</button><button id="tools-tab" role="tab" aria-controls="tools" aria-selected="false" tabindex="-1">Languages &amp; tools</button>
      </div>
      <div id="domains" class="skills-panel"><h3>Technical domains</h3><ul class="skill-list"><li>Reinforcement learning</li><li>Imitation learning</li><li>Motion forecasting</li><li>Computer vision</li><li>Transformer architectures</li><li>Multi-agent simulation</li><li>Model training &amp; evaluation</li><li>Statistical analysis</li></ul></div>
      <div id="tools" class="skills-panel"><h3>Languages &amp; tools</h3><ul class="skill-list"><li>Python</li><li>C++</li><li>PyTorch</li><li>MLflow</li><li>Git</li><li>Docker</li><li>ROS</li><li>Bazel</li><li>Linux</li><li>AWS</li></ul></div>
    </section>
    <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="wrap"><p class="eyebrow">Get in touch</p><h2 id="contact-title">Let’s talk intelligent systems.</h2><p>Research, engineering, and the questions in between.</p><div class="contact-links"><a href="mailto:jason.xi.xiang@gmail.com">Email me</a><a href="https://www.linkedin.com/in/fengxiang1/">LinkedIn</a><a href="https://github.com/jasonxiang1">GitHub</a></div></div></section>
  </main>
  <dialog id="project-modal" aria-label="Project overview"><div class="dialog-top"><p class="eyebrow">Project overview</p><button class="close-dialog" autofocus aria-label="Close project overview">Close</button></div><div id="modal-content"></div></dialog>
  <template id="preview-coborg"><h2 id="preview-title-coborg">Backpack-Mounted Third Robot Arm</h2><p>Motion planning and stabilization for COBORG, a wearable robotic arm that assists technicians with overhead panel installation.</p><p class="dialog-result"><strong>84.62%</strong> task success in panel installation tests</p><a class="button" href="pages/coborg.html">Explore project</a></template>
  <template id="preview-gqa"><h2 id="preview-title-gqa">Scene Graphs for Visual Question Answering</h2><p>Generating structured relationships between objects to improve visual question answering when scene graph annotations are missing.</p><p class="dialog-result"><strong>11%</strong> GraphVQA accuracy improvement on scene graph-deficient test sets</p><a class="button" href="pages/gqa.html">Explore project</a></template>
  <template id="preview-centerpoint"><h2 id="preview-title-centerpoint">CenterPoint Joint Object–Attribute Prediction</h2><p>Extending a LiDAR-based 3D detector to jointly predict objects and attributes, including vehicle type and pedestrian posture.</p><p class="dialog-result"><strong>83%</strong> average precision for vehicle and pedestrian object–attribute pairs</p><a class="button" href="pages/centerpoint.html">Explore project</a></template>
</SiteLayout>
